[Unit]
Description=remote-voice: Mira's winhvk voice on laphvk's speakers
After=pipewire.service pipewire-pulse.service network-online.target
Wants=pipewire-pulse.service
PartOf=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/lib/remote-voice/remote_voice.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
