# Mira's body on laphvk (argus/pet/mira-pet). Enable once:
#   ln -s ~/argus/argus/pet/mira-pet ~/.config/quickshell/mira-pet
#   systemctl --user link ~/argus/argus/pet/systemd/mira-pet.service && systemctl --user enable --now mira-pet
[Unit]
Description=Mira's sprite on the desktop (Quickshell)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/quickshell -c mira-pet
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
